{
  "name": "@aethermesh/client",
  "version": "0.1.0",
  "description": "TypeScript client for AetherMesh: publish data, run WebAssembly tasks across a mesh of machines",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "aethermesh",
    "distributed",
    "wasm",
    "scheduler"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "example:hash": "node examples/hash.ts",
    "example:wasm": "node examples/wasm.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.2"
  }
}
